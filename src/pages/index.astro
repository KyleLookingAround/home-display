---
import Dashboard from '../layouts/Dashboard.astro';
import Tariffs from '../components/Tariffs.svelte';
import Period from '../components/Period.svelte';
import Totals from '../components/Totals.svelte';
import DailyUse from '../components/DailyUse.svelte';
import BillTracker from '../components/BillTracker.svelte';
import PriceCap from '../components/PriceCap.svelte';
import Rewards from '../components/Rewards.svelte';
import MissionLog from '../components/MissionLog.svelte';
---
<Dashboard page="index" title="Overview">
  <Tariffs client:load />
  <Period client:load />
  <Totals client:load />
  <DailyUse client:load />
  <div class="grid2">
    <BillTracker client:load />
    <PriceCap client:load />
  </div>
  <div class="grid2">
    <Rewards client:load />
    <MissionLog client:load />
  </div>
</Dashboard>
