---
import Dashboard from '../layouts/Dashboard.astro';
import Period from '../components/Period.svelte';
import UsageProfile from '../components/UsageProfile.svelte';
import BoilerCheck from '../components/BoilerCheck.svelte';
import Spikes from '../components/Spikes.svelte';
import Footprint from '../components/Footprint.svelte';
import GasWeather from '../components/GasWeather.svelte';
---
<Dashboard page="patterns" title="Patterns">
  <Period client:load />
  <UsageProfile client:load />
  <BoilerCheck client:load />
  <Spikes client:load />
  <div class="grid2">
    <Footprint client:load />
    <GasWeather client:load />
  </div>
</Dashboard>
