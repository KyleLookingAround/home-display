---
/*
 * Every dashboard page: the head, the starfield, the bridge (header, account and alerts), the tabs and the footer.
 * Tabs are pages, linked relatively so the site works at any address (GitHub Pages, the home server helper).
 */
import '../styles/dashboard.css';
import Bridge from '../components/Bridge.svelte';
interface Props { page: string; title: string }
const { page, title } = Astro.props;
const TABS = [['index', 'Overview'], ['patterns', 'Patterns'], ['prices', 'Prices'], ['compare', 'Compare'], ['home', 'Home']];
---
<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>{page === 'index' ? 'Harold Street Energy' : `${title} · Harold Street Energy`}</title>
<meta name="theme-color" content="#04050d">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Energy">
<link rel="manifest" href="manifest.webmanifest">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%2304050d'/%3E%3Ccircle cx='32' cy='32' r='15' fill='none' stroke='%234fd6ff' stroke-width='3'/%3E%3Cpath d='M35 14 24 35h9l-4 15 12-22h-9z' fill='%23ffb547'/%3E%3C/svg%3E">
<link rel="apple-touch-icon" href="icon-180.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Syncopate:wght@400;700&family=Exo+2:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap">
</head>
<body>
<canvas id="stars" aria-hidden="true"></canvas>
<div class="wrap">
  <Bridge client:load />
  <nav class="tabs" aria-label="Sections">
    {TABS.map(([id, label]) => <a href={`./${id}.html`} aria-current={id === page ? 'page' : undefined}>{label}</a>)}
  </nav>
  <main class="tabpanel" data-page={page}>
    <slot />
  </main>
  <footer>
    <p>All prices include VAT. Gas in cubic metres is converted to kWh with a volume correction of 1.02264 and a calorific value of 39.5 MJ/m³, so gas figures are close estimates. Smart meter readings arrive a day behind, so charts cover full days up to yesterday.</p>
    <p>Simulations, projections and savings are estimates to help you decide what to look into. They aren't financial advice or quotes.</p>
  </footer>
</div>
<script>import '../starfield.js';</script>
</body>
</html>
