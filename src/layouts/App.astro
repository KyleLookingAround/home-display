---
/*
 * Every page of the app: the head, the starfield, the navigation (a bottom bar on a phone, a rail from 900px),
 * the header (title, status, Refresh, and Settings on a phone) and the footer. Settings sits in the rail on a laptop. Pages are links, relative, so the site works at any address.
 */
import '../styles/app.css';
import Header from '../components/Header.svelte';
interface Props { page: string; title: string }
const { page, title } = Astro.props;
const NAV = [
  ['index', 'Now', '<path d="M13 2 4 14h7l-1 8 9-12h-7z"/>'],
  ['money', 'Money', '<path d="M17 5.5A5 5 0 0 0 8.5 9v2.5"/><path d="M6 11.5h8"/><path d="M8.5 11.5c0 3-1 5.5-2.5 7.5h12"/>'],
  ['usage', 'Usage', '<path d="M4 20V10"/><path d="M10 20V4"/><path d="M16 20v-7"/><path d="M22 20H2"/>'],
  ['home', 'Home', '<path d="M3 11 12 3l9 8"/><path d="M5 9.5V21h14V9.5"/><path d="M10 21v-6h4v6"/>'],
  ['screen', 'Screen', '<rect x="2.5" y="4" width="19" height="13" rx="2"/><path d="M8 21h8M12 17v4"/>'],
  ['settings', 'Settings', '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/>']
];
---
<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>{page === 'index' ? 'Harold Street' : `${title} · Harold Street`}</title>
<meta name="theme-color" content="#04050d">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Harold St">
<link rel="manifest" href="manifest.webmanifest">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%2304050d'/%3E%3Ccircle cx='32' cy='32' r='15' fill='none' stroke='%234fd6ff' stroke-width='3'/%3E%3Cpath d='M35 14 24 35h9l-4 15 12-22h-9z' fill='%23ffb547'/%3E%3C/svg%3E">
<link rel="apple-touch-icon" href="icon-180.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Syncopate:wght@400;700&family=Exo+2:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap">
<script is:inline>try { if (localStorage.getItem('hse.corners') === 'sharp') document.documentElement.dataset.corners = 'sharp'; } catch (e) {}</script>
</head>
<body>
<canvas id="stars" aria-hidden="true"></canvas>
<div class="app">
  <nav class="nav" aria-label="Pages">
    <a class="brand" href="./index.html">Harold Street</a>
    {NAV.map(([id, label, icon]) => (
      <a class={id === 'settings' ? 'item rail-only' : 'item'} href={`./${id}.html`} aria-current={id === page ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon} />
        <span>{label}</span>
      </a>
    ))}
  </nav>
  <div class="main">
    <Header client:load title={title} page={page} />
    <main class="page" data-page={page}>
      <slot />
    </main>
    <footer class="foot">
      <p>Prices include VAT. Gas in cubic metres is converted to kWh (volume correction 1.02264, calorific value 39.5 MJ/m³). Smart meter readings arrive a day behind.</p>
      <p>Projections, simulations and savings are estimates to help you decide what to look into, not advice or quotes.</p>
    </footer>
  </div>
</div>
<script>import '../starfield.js';</script>
{import.meta.env.PROD && <script is:inline>
  // Keeps the pages on this device, so they open at once and with no signal (public/sw.js).
  try { if ('serviceWorker' in navigator && (location.protocol === 'https:' || /^(localhost|127\.0\.0\.1)$/.test(location.hostname))) navigator.serviceWorker.register('sw.js').catch(function(){}); } catch (e) {}
</script>}
</body>
</html>
